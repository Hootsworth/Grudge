# AI Provider & Model Configuration
# AI_PROVIDER: "gemini" | "openai" | "anthropic" | "meta" | "groq" | "together" (defaults to auto-detection)
AI_PROVIDER="gemini"

# AI_MODEL: model override (e.g. gemini-2.0-flash, gpt-4o, claude-3-5-sonnet-20241022, llama-3.3-70b-versatile)
AI_MODEL="gemini-2.0-flash"

# Universal AI API Key (or use provider-specific keys below)
AI_API_KEY=""

# Provider-Specific API Keys (auto-detected if set):
GEMINI_API_KEY=""
GOOGLE_API_KEY=""
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
META_API_KEY=""
GROQ_API_KEY=""

# Optional Web Search API Key (Tavily or Brave) for fake verification
SEARCH_API_KEY="your-search-api-key"
SEARCH_PROVIDER="tavily"

# Webhook to receive 05:00 UTC pending puzzle preview for review
PREVIEW_WEBHOOK_URL="https://discord.com/api/webhooks/..."

# Secret token to authenticate admin actions (e.g. vetoing a pending puzzle)
VETO_SECRET="your-admin-veto-secret"
