# Pinpoint Configuration & Secrets

# Cloudflare Credentials (for worker deployment and D1/KV sync)
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
PINPOINT_DATABASE_ID=your-pinpoint-d1-uuid
PINPOINT_KV_ID=your-pinpoint-kv-uuid

# Worker URL and Admin Authentication
PINPOINT_WORKER_URL=https://pinpoint-backend.<subdomain>.workers.dev
APPROVAL_SECRET=your-secure-admin-secret-key

# Anthropic API Key for daily spot fact generation (claude-sonnet-4-6)
ANTHROPIC_API_KEY=your-anthropic-api-key

# Review Email Configuration (Resend, SendGrid, or SMTP)
REVIEW_EMAIL_RECIPIENT=reviewer@example.com
RESEND_API_KEY=your-resend-api-key
