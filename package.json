{
  "name": "strata-backend",
  "version": "1.0.0",
  "description": "Daily backend for Strata - historical timeline sorting game on Cloudflare Workers + D1",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "test": "node --experimental-strip-types --test tests/strata/*.test.ts",
    "test:kin": "cd kin && npm test",
    "test:passphew": "cd passphew && npm test",
    "test:pinpoint": "cd pinpoint && npm test",
    "test:all": "npm test && (cd kin && npm test) && (cd passphew && npm test) && (cd pinpoint && npm test) && python3 -m unittest discover -s tests -p \"test_*.py\"",
    "seed": "node --experimental-strip-types scripts/seed.ts",
    "seed:kin": "cd kin && npm run seed",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "keywords": ["strata", "cloudflare-workers", "d1", "timeline-game"],
  "author": "",
  "license": "MIT",
  "dependencies": {},
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240405.0",
    "typescript": "^5.4.5",
    "wrangler": "^3.50.0"
  }
}
