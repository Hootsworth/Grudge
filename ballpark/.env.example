# Ballpark Backend Environment Variables

# Cloudflare D1
BALLPARK_DATABASE_ID="local-ballpark-db-id"
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Admin / Pipeline Approval
APPROVAL_SECRET="ballpark-admin-secret-key"

# Anthropic API (for nightly claude-sonnet-4-6 candidate proposal & extraction)
ANTHROPIC_API_KEY="sk-ant-..."

# Review Email (Resend or Mailgun)
RESEND_API_KEY="re_..."
REVIEW_EMAIL_TO="aditya@example.com"
APP_BASE_URL="https://ballpark-backend.adityapdixit.workers.dev"
